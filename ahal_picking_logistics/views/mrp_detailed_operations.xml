<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ahal_picking_logistics_stock_move_line_do_list" model="ir.ui.view">
        <field name="name">stock.move.line.list.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <!--<field name="picking_id"/>-->
                <field name="kd_cargo" optional="show"/>
                <field name="flete_id" optional="show"/>
                <field name="fecha_entrada" optional="show"/>
                <field name="qty_done_pass" optional="show"/>
                <!--<field name="custom_field"/>-->
            </xpath>
            <!--<xpath expr="//field[@name='qty_done']" position="attributes">
                <attribute name="default">qty_done_pass</attribute> 
            </xpath>-->
        </field>
    </record>
</odoo>
