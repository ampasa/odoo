<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ahal_picking_logistics_stock_lot_form" model="ir.ui.view">
        <field name="name">stock.lot.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <group name="main_group" position="inside">
                <group name="custom_group" string="">
                    <field name="kd_cargo"/>
                    <field name="flete_id"/>
                    <field name="fecha_entrada"/>
                    <field name="temperature"/>
                </group>
            </group>            
        </field>
    </record>

    <record id="ahal_picking_logistics_stock_production_lot_tree" model="ir.ui.view">
        <field name="name">stock.production.lot.list.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">                
                <field name="temperature"/>
            </xpath>            
        </field>
    </record>
</odoo>